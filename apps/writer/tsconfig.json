{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		// Resolve harness types from the sibling clone's source so a fresh
		// checkout typechecks before the harness has ever been built (bun's
		// file: install copies a snapshot that only carries dist/ when the
		// harness happened to be built first).
		"paths": {
			"@drive-mode/drive-kernel": [
				"../../../cline-drivecode/sdk/dist-bundle/drive-kernel/src/index.ts"
			]
		},
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"],
		"lib": ["ES2022"]
	},
	"include": ["src/**/*.ts"]
}
